/* Native SDK arguments are 64-bit slots; value_bits is widened unchanged. */
#include <stdint.h>

#ifndef HDPL_CC

#include "xh2rt_kernel.h"

int xh2rt_fill_f32(xh2rt_context *context, xh2rt_buffer_view *destination, uint32_t value_bits, uint64_t count)
{
    xh2rt_kernel_slot slots[3];
    uint64_t bytes;

    if (count > UINT64_MAX / sizeof(uint32_t))
        return xh2rt_kernel_reject(context, XH2RT_KERNEL_REJECT_OVERFLOW,
                                   "fill_f32.count");
    bytes = count * sizeof(uint32_t);
    slots[0] = xh2rt_kernel_buffer(
        destination, 0, bytes, count != 0 ? sizeof(uint32_t) : 1);
    slots[1] = xh2rt_kernel_word(value_bits);
    slots[2] = xh2rt_kernel_word(count);
    return xh2rt_kernel_invoke(
        context, "fill_f32", slots,
        sizeof(slots) / sizeof(slots[0]), count != 0);
}

#else

#include "xh2rt_kernel.h"

__global__ extern "C" void fill_f32(uint64_t completion_iomap,
                                    uint64_t dst_addr,
                                    uint64_t value_bits_arg,
                                    uint64_t count) {
    xh2rt_kernel_scope scope{};

    uint32_t outcome = xh2rt_kernel_scope_begin(
        scope, completion_iomap, 0);
    if (outcome == XH2RT_KERNEL_OUTCOME_OK &&
        (count > UINT64_MAX / sizeof(uint32_t) ||
        (count != 0 && (dst_addr == 0 || (dst_addr & 3u) != 0 ||
         dst_addr > UINT64_MAX - count * sizeof(uint32_t)))))
        outcome = XH2RT_KERNEL_OUTCOME_INVALID_ARGUMENT;

    if (outcome == XH2RT_KERNEL_OUTCOME_OK) {
        /* Split without multiplying count by the eight-stripe index. */
        const uint64_t stripe = scope.core_tile_index;
        const uint64_t quotient = count / XH2RT_CORE_TILE_COUNT;
        const uint64_t remainder = count % XH2RT_CORE_TILE_COUNT;
        const uint64_t start =
            quotient * stripe + (stripe < remainder ? stripe : remainder);
        const uint64_t stripe_count =
            quotient + (stripe < remainder ? 1 : 0);

        /* Give each RV hart a contiguous, disjoint part of the tile stripe. */
        const uint64_t lane = scope.hart_lane;
        const uint64_t hart_quotient =
            stripe_count / XH2RT_HARTS_PER_TILE;
        const uint64_t hart_remainder =
            stripe_count % XH2RT_HARTS_PER_TILE;
        const uint64_t hart_start =
            hart_quotient * lane +
            (lane < hart_remainder ? lane : hart_remainder);
        const uint64_t hart_count =
            hart_quotient + (lane < hart_remainder ? 1 : 0);

        if (hart_count != 0) {
            const uint64_t element_offset = start + hart_start;
            volatile uint32_t *dst =
                reinterpret_cast<volatile uint32_t *>(dst_addr) +
                element_offset;
            const uint32_t value_bits = (uint32_t)value_bits_arg;

            for (uint64_t i = 0; i < hart_count; ++i)
                dst[i] = value_bits;
            RISCV_FENCE_RW_RW;
        }
    }

    xh2rt_kernel_scope_finish(scope, outcome);
}

int main(void) {
    return 0;
}

#endif
